      <url>https://raw.githubusercontent.com/stripe/stripe-terminal-java/master/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>stripe</id>
      <name>Stripe</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git@github.com/stripe/stripe-terminal-java.git</connection>
    <developerConnection>scm:git@github.com/stripe/stripe-terminal-java.git</developerConnection>
    <url>https://github.com/stripe/stripe-terminal-java</url>
  </scm>
  <dependencies>
